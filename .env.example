# Copy to .env (never committed). Every variable is optional unless marked.

# REQUIRED for compose: the hostname Traefik routes to this app.
BUDGET_HOST=budget.example.com

# The address browsers use, as the address bar shows it (https://host, no path).
# The CSRF check compares a form post's Origin with it exactly. Compose derives it
# from BUDGET_HOST when unset. REQUIRED while COOKIE_SECURE is true; plain-http
# local development defaults to http://localhost:PORT.
# PUBLIC_URL=https://budget.example.com

# Where the SQLite database lives. The image sets /data/budget.db (a named volume).
# DB_PATH=data/budget.db

# Session cookies are Secure (https only) unless this is false. Set false ONLY
# for plain-http local development (`make run` sets it for you).
# COOKIE_SECURE=true

# How long a sign-in lasts at most (the absolute limit). A session also ends after
# 7 days without use (or this value, when shorter), and a password change ends every
# session regardless.
# SESSION_TTL=720h

# Where the client address for rate limiting is read from: remote (the TCP peer;
# the default), forwarded (leftmost X-Forwarded-For) or cloudflare
# (CF-Connecting-IP). Behind Traefik leave it unset: every client then shares
# one bucket, which is coarse but safe, whereas the headers are client-settable
# there. Use cloudflare only where the Cloudflare tunnel is the sole way in.
# CLIENT_IP_SOURCE=remote

# One-time token for claiming the first account at /setup. Leave unset and one is
# generated and printed in the log on first start (docker compose logs budget).
# If set, at least 32 characters: openssl rand -base64 32
# SETUP_TOKEN=

# A VACUUM INTO copy of the database is made at startup and once a day into BACKUP_DIR
# (default: a backups folder beside the database, i.e. inside the same volume) and the
# newest BACKUP_KEEP are kept. The app owns that folder and makes it private (0700), so
# point it at a folder used for nothing else. 0 turns backups off. They do not survive
# losing the disk: copy the folder off the machine yourself; see README.
# BACKUP_DIR=/data/backups
# BACKUP_KEEP=14

# --- Daily FNB fetch (optional; without FNB_USERNAME it is off) ----------------
# The online banking username. The password goes in ./secrets/fnb_password (one
# line, chmod 600), which compose mounts as a docker secret; a plain FNB_PASSWORD
# variable is refused.
# FNB_USERNAME=
# If your login has several profiles (personal and business, say), the exact name
# of the one to use, as FNB's "Linked Profiles" page shows it.
# FNB_PROFILE=
# Daily run time, South African time.
# FETCH_AT=06:00
# FNB product codes to fetch: DDA cheque, ZFN credit card (TOA savings, MLS loan).
# FNB_PRODUCTS=DDA,ZFN
